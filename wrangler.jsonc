{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consumo-plantas",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    "SHEET_ID": "PEGAR_AQUI_EL_ID_DE_LA_PLANILLA",
    "SHEET_GID": "290742623",
    "METAS_SHEET": "Metas",
    "CACHE_SECONDS": "300"
  },
  "observability": { "enabled": true }
}
